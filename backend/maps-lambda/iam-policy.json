{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RhumbMapMetadata",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:531312113686:table/rhumb-maps"
    },
    {
      "Sid": "RhumbMapDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::bottle-of-rhumb-map-documents-531312113686/maps/*"
    }
  ]
}
